{
  "name": "port-monitor",
  "version": "0.1.0",
  "description": "Realtime port monitor with WSL support",
  "main": "dist-electron/electron/main.js",
  "author": "port-monitor",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --external:electron --outfile=dist-electron/electron/preload.js --format=cjs",
    "build:electron": "tsc -p tsconfig.electron.json && npm run build:preload",
    "build": "npm run build:electron && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && npm run build:electron && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "esbuild": "^0.21.5",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-window": "^1.8.10",
    "@types/react-window": "^1.8.8",
    "zustand": "^4.5.0"
  }
}
